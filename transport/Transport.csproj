    <RootNamespace>WithFriends.Transport</RootNamespace>
    <AssemblyName>WithFriends.Transport</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\protocol\Protocol.csproj" />
  </ItemGroup>

</Project>
