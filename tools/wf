#!/usr/bin/env bash
# wf — a linha de comando do With Friends.
#
# Uma porta só para tudo que se faz fora do jogo: subir o coordenador, abrir as
# instâncias, rodar uma visita inteira sozinha, comparar os diários e auditar o
# assembly. Ver tools/README.md para o porquê de cada uma.
#
# Feita para ser usada por gente e por ferramenta. Toda saída é texto estável em
# stdout, todo erro vai para stderr, e o código de saída diz o que aconteceu:
#
#   0  deu certo — e, em `comparar`, os dois lados bateram
#   1  falhou
#   2  uso errado
#   3  `comparar` achou divergência (não é erro: é o resultado)

set -euo pipefail

# Resolve o próprio caminho antes de subir um nível: chamado por um symlink em
# ~/.local/bin, `dirname` daria /home/você/.local e a raiz do repositório
# ficaria errada — o `wf` sairia procurando tools/ dentro de .local e falharia
# sem dizer por quê.
EU="${BASH_SOURCE[0]}"
while [[ -L "$EU" ]]; do
    ALVO="$(readlink "$EU")"
    [[ "$ALVO" == /* ]] && EU="$ALVO" || EU="$(dirname "$EU")/$ALVO"
done
RAIZ="$(cd "$(dirname "$EU")/.." && pwd)"
JOGO="${WF_JOGO:-$HOME/.local/share/Steam/steamapps/common/RimWorld}"
DADOS_P1="${WF_DADOS_P1:-$HOME/.config/unity3d/Ludeon Studios/RimWorld by Ludeon Studios}"
DADOS_P2="${WF_DADOS_P2:-$HOME/.rimworld-jogador2}"
DADOS_ARB="${WF_DADOS_ARB:-$HOME/.rimworld-arbitro}"
PORTA="${WF_PORTA:-25555}"

msg() { printf '%s\n' "$*"; }
erro() { printf '%s\n' "$*" >&2; }

ajuda() {
cat <<'FIM'
wf — linha de comando do With Friends

  wf servidor [porta]              sobe o coordenador em primeiro plano
  wf jogos [--arbitro SAVE]        abre duas instâncias para jogar/testar à mão
      --caminho | --sangue         liga os rastreios nos dois lados
  wf rodar SAVE [ticks]            roda UMA colônia sem interface e relata
      --velocidade V               Normal|Fast|Superfast|Ultrafast
      --p2                         usa o save da pasta do jogador 2
      --controle P                 abre a porta de controle em 127.0.0.1:P
  wf emular HOST ARB [segundos]    roda uma visita inteira sozinha e sai
      --roteiro raid|combate|mover  provoca assalto, briga ou ordens de ir
      --visivel                    com janela, para acompanhar em tempo real
      --sangue                     rastreia a decisão de largar sangue
      --caminho                    rastreia as decisões do pathfinding
      --velocidade V               Normal|Fast|Superfast|Ultrafast (padrão Fast)
      --controle P                 porta de controle: anfitrião em P, árbitro em P+1
      --semdigital                 não detectar divergência (medir deriva; ADR 0022)
      --sem-compilar               pula o build (quem repete a corrida já compilou)
  wf comparar                      compara os dois diários mais novos
  wf deriva A B                    quanto os dois lados se afastam, tick a tick (ADR 0022)
  wf erros [--todos]               agrupa erros e avisos; destaca os de um lado só
  wf controle [--porta P] [cmd]    dirige um jogo aberto com -controle=P
  wf dirigir CENARIO               visita inteira com gestos de interface, e compara
      --visivel                    com as duas janelas lado a lado, para acompanhar
  wf decisoes [--todos|--nossos]   mapa das decisões de jogador, extraído do MP
  wf auditar                       audita o assembly do jogo (alcance + MP)
      --escritores T::campo        quem escreve naquele campo (a pergunta da família de closures)
      --chamadores T::metodo       quem chama aquele método (decide remendar fonte ou chamador)
  wf saves [p1|p2]                 lista os saves de cada instância
  wf diarios                       lista os diários mais novos de cada lado
  wf matar                         fecha jogos e coordenador
  wf status                        o que está rodando agora

Variáveis: WF_JOGO, WF_DADOS_P1, WF_DADOS_P2, WF_DADOS_ARB, WF_PORTA.
FIM
}

# **`pkill -f` é uma arma que atira para trás.**
#
# `-f` casa com a linha de comando INTEIRA de qualquer processo — inclusive a do
# shell que digitou `pkill -f RimWorldLinux`, a do editor com o arquivo aberto, a
# do orquestrador que só queria matar o jogo. Foi assim que uma corrida da ADR
# 0022 matou o próprio orquestrador no primeiro segundo, três vezes seguidas,
# sem deixar rastro: o processo que ia ler o resultado morria junto com o alvo.
#
# `-x` casa com o NOME do processo e com mais nada. Para o jogo, que se chama
# RimWorldLinux, é exatamente o que se quer.
#
# Mata todo jogo e ESPERA ficar limpo duas vezes seguidas.
#
# Um `pkill` só não basta: o anfitrião lança o árbitro alguns segundos depois de
# subir, e matar o anfitrião na fresta antes disso deixa o árbitro órfão vivo.
# Órfão vivo é identidade duplicada no coordenador — os dois se derrubam a cada
# 15s e a visita nunca sai do passo 0. Foi assim que uma corrida inteira da ADR
# 0022 se perdeu, com o barulho de várias simulações ao mesmo tempo.
fechar_jogos() {
    local limpo=0 i
    for i in $(seq 1 15); do
        pkill -9 -x RimWorldLinux >/dev/null 2>&1 || true
        sleep 2
        if pgrep -x RimWorldLinux >/dev/null 2>&1; then limpo=0; else limpo=$((limpo + 1)); fi
        # `if` e não `[[ … ]] && return`: com `set -e`, um `[[ … ]]` falso no
        # fim do corpo do laço encerra o script inteiro — silenciosamente, sem
        # uma linha sequer no log. Foi o que fez nove tentativas seguidas se
        # declararem "o processo do jogo sumiu" quando o jogo nem chegou a ser
        # lançado.
        if [[ $limpo -ge 2 ]]; then return 0; fi
    done
    erro "não consegui fechar todos os jogos"
    return 1
}

compilar_cliente() { dotnet build "$RAIZ/client/Client.csproj" -v q --nologo; }
compilar_servidor() { dotnet build "$RAIZ/server/Server.csproj" -v q --nologo; }

subir_servidor_fundo() { compilar_servidor; subir_servidor_fundo_sem_compilar; }

subir_servidor_fundo_sem_compilar() {
    pkill -f 'WithFriends[.]Server[.]dll' >/dev/null 2>&1 || true
    sleep 1
    nohup dotnet "$RAIZ/server/bin/Debug/WithFriends.Server.dll" "$PORTA" "$RAIZ/dados" \
        > "$RAIZ/dados-servidor.log" 2>&1 &
    sleep 2
    msg "coordenador em :$PORTA  (log: $RAIZ/dados-servidor.log)"
}

# A pasta de uma instância automática precisa da lista de mods e do save. Sem a
# lista ela sobe sem o nosso mod e o sintoma é "nunca apareceu online".
semear_pasta() {
    local destino="$1" save="$2"
    mkdir -p "$destino/Config" "$destino/Saves"
    cp -n "$DADOS_P1/Config/ModsConfig.xml" "$destino/Config/" 2>/dev/null || true
    local origem
    for origem in "$DADOS_P1/Saves" "$DADOS_P2/Saves"; do
        [[ -f "$origem/$save.rws" ]] && { cp -n "$origem/$save.rws" "$destino/Saves/" 2>/dev/null || true; break; }
    done
    [[ -f "$destino/Saves/$save.rws" ]] || { erro "save não encontrado: $save"; return 1; }
}

# Largura e altura da tela, ou um palpite razoável se não der para descobrir.
tamanho_da_tela() {
    local m
    m=$(xrandr --current 2>/dev/null | grep -m1 '\*' | awk '{print $1}') || true
    if [[ "$m" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        printf '%s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}"
    else
        printf '1920 1080\n'
    fi
}

# Põe as duas janelas lado a lado depois que elas abrem.
#
# Melhor esforço, de propósito: o Unity não tem argumento de POSIÇÃO — só de
# tamanho —, e posicionar depende do gerenciador de janelas. Numa sessão Wayland
# isto só funciona porque o jogo roda sob XWayland. Se falhar, as duas janelas
# aparecem com o tamanho certo em cima uma da outra, que é ruim mas não impede
# nada — por isso nada aqui interrompe a emulação.
alinhar_janelas() {
    command -v xdotool >/dev/null 2>&1 || return 0

    local largura altura n=0 ids
    read -r largura altura < <(tamanho_da_tela)

    # Esperar as duas aparecerem: o árbitro só sobe depois do anfitrião.
    while [[ $n -lt 60 ]]; do
        ids=$(xdotool search --class RimWorld 2>/dev/null | tail -2) || true
        [[ $(printf '%s\n' "$ids" | grep -c .) -ge 2 ]] && break
        sleep 2; n=$((n+1))
    done

    local i=0 id
    for id in $ids; do
        xdotool windowmove "$id" $((i * largura / 2)) 0 \
                windowsize "$id" $((largura / 2)) $((altura - 80)) 2>/dev/null || true
        i=$((i+1))
    done
}

cmd_servidor() { [[ -n "${1:-}" ]] && PORTA="$1"; compilar_servidor
    exec dotnet "$RAIZ/server/bin/Debug/WithFriends.Server.dll" "$PORTA" "$RAIZ/dados"; }

cmd_jogos() { exec "$RAIZ/tools/dois-jogos.sh" "$@"; }

# Uma colônia, sem coordenador, sem visita: o RimWorld normal rodando sozinho.
#
# Serve para teste de regressão de mod ("roda 20 mil ticks sem erro?"), medição
# de ticks por segundo e reprodução de bug sem clicar. Nada aqui é de sessão —
# ver client/Bancada/ModoAvulso.cs.
cmd_rodar() {
    local velocidade="" pasta="$DADOS_P1" controle="" args=() pegar_vel=0 pegar_ctl=0
    for a in "$@"; do
        if [[ $pegar_vel -eq 1 ]]; then velocidade="$a"; pegar_vel=0; continue; fi
        if [[ $pegar_ctl -eq 1 ]]; then controle="$a"; pegar_ctl=0; continue; fi
        case "$a" in
            --velocidade)   pegar_vel=1 ;;
            --velocidade=*) velocidade="${a#*=}" ;;
            --controle)     pegar_ctl=1 ;;
            --controle=*)   controle="${a#*=}" ;;
            --p2)           pasta="$DADOS_P2" ;;
            *)              args+=("$a") ;;
        esac
    done

    local save="${args[0]:-}" ticks="${args[1]:-10000}"
    [[ -n "$save" ]] || { erro "uso: wf rodar SAVE [ticks] [--velocidade V] [--p2]"; return 2; }
    [[ -f "$pasta/Saves/$save.rws" ]] || { erro "save não encontrado: $pasta/Saves/$save.rws"; return 1; }

    msg "== compilando"; compilar_cliente

    local extra=""
    [[ -n "$velocidade" ]] && extra="-rodarvelocidade=$velocidade"
    [[ -n "$controle" ]] && extra="$extra -controle=$controle"
    [[ "$pasta" != "$DADOS_P1" ]] && extra="$extra -savedatafolder=$pasta"

    msg "== rodando \"$save\" por $ticks tick(s)$([[ -n "$velocidade" ]] && echo ", $velocidade")"

    # Primeiro plano de propósito: é uma medição, e quem chamou quer o número.
    ( cd "$JOGO" && ./RimWorldLinux -batchmode -nographics \
        -rodar -rodarsave="$save" -rodarticks="$ticks" $extra \
        -logFile "$pasta/Player.log" > /dev/null 2>&1 ) || true

    msg
    grep -a "WithFriends/bancada" "$pasta/Player.log" | sed 's/^/   /' || msg "   (sem relatório — veja $pasta/Player.log)"
}

cmd_emular() {
    local visivel=0 sangue=0 caminho=0 semdigital=0 compilar=1 roteiro="" velocidade="" controle="" args=() pegar_roteiro=0 pegar_vel=0 pegar_ctl=0
    for a in "$@"; do
        if [[ $pegar_roteiro -eq 1 ]]; then roteiro="$a"; pegar_roteiro=0; continue; fi
        if [[ $pegar_vel -eq 1 ]]; then velocidade="$a"; pegar_vel=0; continue; fi
        if [[ $pegar_ctl -eq 1 ]]; then controle="$a"; pegar_ctl=0; continue; fi
        case "$a" in
            --visivel)   visivel=1 ;;
            --sangue)    sangue=1 ;;
            --caminho)   caminho=1 ;;
            --semdigital) semdigital=1 ;;
            --sem-compilar) compilar=0 ;;
            --roteiro)   pegar_roteiro=1 ;;
            --roteiro=*) roteiro="${a#*=}" ;;
            --velocidade)   pegar_vel=1 ;;
            --velocidade=*) velocidade="${a#*=}" ;;
            --controle)     pegar_ctl=1 ;;
            --controle=*)   controle="${a#*=}" ;;
            *)           args+=("$a") ;;
        esac
    done
    local host="${args[0]:-}" arb="${args[1]:-}" seg="${args[2]:-120}"
    [[ -n "$host" && -n "$arb" ]] || { erro "uso: wf emular HOST ARB [segundos] [--visivel]"; return 2; }

    msg "== fechando o que estiver aberto"
    fechar_jogos
    pkill -f 'WithFriends[.]Server[.]dll' >/dev/null 2>&1 || true
    sleep 1

    # **Compilar é o que abre a janela para duas emulações ao mesmo tempo.**
    #
    # Quem repete a corrida (tools/dirigir.py) mata o jogo entre as tentativas.
    # Se a tentativa anterior ainda estiver no `dotnet build`, ela sobe o jogo
    # DEPOIS dessa morte — e aí há dois anfitriões com a mesma identidade, cada
    # um derrubando o outro do coordenador a cada 15s, para sempre. Medido: a
    # corrida da ADR 0022 passou três tentativas nessa guerra sem nunca começar
    # a visita. Quem já compilou passa --sem-compilar e a janela fecha.
    if [[ $compilar -eq 1 ]]; then
        msg "== compilando"; compilar_cliente
        subir_servidor_fundo
    else
        subir_servidor_fundo_sem_compilar
    fi
    semear_pasta "$DADOS_ARB" "$arb" || return 1

    local semtela="-batchmode -nographics" extra=""
    [[ -n "$roteiro" ]] && extra="-emulacaoroteiro=$roteiro"
    [[ $sangue -eq 1 ]] && extra="$extra -rastrearsangue"
    [[ $caminho -eq 1 ]] && extra="$extra -rastrearcaminho"
    [[ -n "$velocidade" ]] && extra="$extra -emulacaovelocidade=$velocidade"
    [[ -n "$controle" ]] && extra="$extra -controle=$controle"
    # Medição da ADR 0022: a digital fica calada e os dois lados correm livres.
    [[ ${semdigital:-0} -eq 1 ]] && extra="$extra -semdigital"
    if [[ $visivel -eq 1 ]]; then
        semtela=""
        # Unity abre em tela cheia por padrão, e duas instâncias em tela cheia
        # se cobrem — não dá para ver as duas, que é o ponto do modo visível.
        # `-screen-fullscreen 0` com metade da largura deixa as duas lado a lado.
        local largura altura
        read -r largura altura < <(tamanho_da_tela)
        extra="$extra -emulacaovisivel -screen-fullscreen 0 -screen-width $((largura / 2)) -screen-height $((altura - 80))"
    fi

    msg "== anfitrião \"$host\" × árbitro \"$arb\", ${seg}s$([[ -n "$roteiro" ]] && echo ", roteiro $roteiro")$([[ -n "$velocidade" ]] && echo ", $velocidade")$([[ $visivel -eq 1 ]] && echo ' (visível)')"
    ( cd "$JOGO" && nohup ./RimWorldLinux $semtela $extra \
        -emulacao -emulacaosave="$host" -arbitrosave="$arb" -emulacaosegundos="$seg" \
        -logFile "$DADOS_P1/Player.log" > /dev/null 2>&1 & )

    msg "   o anfitrião lança o árbitro sozinho em $DADOS_ARB"
    [[ $visivel -eq 1 ]] && ( alinhar_janelas & ) >/dev/null 2>&1
    msg "   acompanhar:  tail -f \"$DADOS_P1/Player.log\" | grep --line-buffered WithFriends"
    msg "   ao terminar: wf comparar"
}

cmd_comparar() { exec python3 "$RAIZ/tools/comparar-diarios.py"; }

cmd_deriva() { exec python3 "$RAIZ/tools/deriva.py" "$@"; }

cmd_erros() { exec python3 "$RAIZ/tools/erros.py" "$@"; }

cmd_controle() { exec python3 "$RAIZ/tools/controle.py" "$@"; }

cmd_dirigir() { exec python3 "$RAIZ/tools/dirigir.py" "$@"; }

cmd_decisoes() { exec python3 "$RAIZ/tools/decisoes.py" "$@"; }

cmd_auditar() {
    local dll="$RAIZ/referencia/jogo/steam-1.6.4871/Managed/Assembly-CSharp.dll"
    local mp="$RAIZ/referencia/repos/Multiplayer/Source"
    [[ -f "$dll" ]] || dll="$JOGO/RimWorldLinux_Data/Managed/Assembly-CSharp.dll"
    [[ -f "$dll" ]] || { erro "assembly do jogo não encontrado"; return 1; }

    # Consultas pontuais ficam em primeiro plano e não escrevem relatório: são
    # perguntas de quem está no meio de um remendo, não auditoria.
    if [[ "${1:-}" == "--escritores" || "${1:-}" == "--chamadores" ]]; then
        exec dotnet run --project "$RAIZ/tools/Auditor" -c Release -- "$dll" "$1" "${2:-}"
    fi

    exec dotnet run --project "$RAIZ/tools/Auditor" -c Release -- \
        "$dll" "${1:-$RAIZ/auditoria.txt}" "$mp"
}

cmd_saves() {
    local pasta="$DADOS_P1"; [[ "${1:-p1}" == "p2" ]] && pasta="$DADOS_P2"
    ls -t "$pasta/Saves"/*.rws 2>/dev/null | while read -r f; do basename "$f" .rws; done
}

cmd_diarios() {
    local p
    for p in "$DADOS_P1" "$DADOS_P2" "$DADOS_ARB"; do
        local d; d=$(ls -t "$p/WithFriends/diario"/*.log 2>/dev/null | head -1) || true
        [[ -n "${d:-}" ]] && printf '%s\n' "$d"
    done
}

cmd_matar() {
    pkill -x RimWorldLinux >/dev/null 2>&1 || true
    pkill -f 'WithFriends[.]Server[.]dll' >/dev/null 2>&1 || true

    # Um jogo que ignora o TERM segura a janela dele, e a corrida seguinte abre
    # em cima de uma tela cheia órfã. Dá meio segundo e insiste.
    sleep 1
    pkill -9 -x RimWorldLinux >/dev/null 2>&1 || true

    msg "fechado."
}

cmd_status() {
    msg "jogos rodando:       $(pgrep -cf RimWorldLinux || echo 0)"
    msg "coordenador:         $(pgrep -cf WithFriends.Server || echo 0)"
    cmd_diarios | sed 's/^/diário: /'
}

case "${1:-}" in
    servidor) shift; cmd_servidor "$@" ;;
    jogos)    shift; cmd_jogos "$@" ;;
    rodar)    shift; cmd_rodar "$@" ;;
    emular)   shift; cmd_emular "$@" ;;
    comparar) shift; cmd_comparar "$@" ;;
    deriva)   shift; cmd_deriva "$@" ;;
    erros)    shift; cmd_erros "$@" ;;
    controle) shift; cmd_controle "$@" ;;
    dirigir)  shift; cmd_dirigir "$@" ;;
    decisoes) shift; cmd_decisoes "$@" ;;
    auditar)  shift; cmd_auditar "$@" ;;
    saves)    shift; cmd_saves "$@" ;;
    diarios)  shift; cmd_diarios "$@" ;;
    matar)    shift; cmd_matar "$@" ;;
    status)   shift; cmd_status "$@" ;;
    -h|--help|help|"") ajuda ;;
    *) erro "comando desconhecido: $1"; ajuda >&2; exit 2 ;;
esac
